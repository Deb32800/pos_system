# Database URL
# For local SQLite (recommended for single-shop offline deployment)
# Use a relative path to store the DB file within the project directory
DATABASE_URL="file:./pos.db?connection_limit=1&socket_timeout=10"

# For Postgres (optional for multi-terminal or heavier concurrency)
# DATABASE_URL="postgresql://user:password@host:5432/pos"

# App settings
CURRENCY=yen
LOCALE=en-HK
UPLOAD_MAX_SIZE_MB=5
